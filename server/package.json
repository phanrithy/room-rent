{
  "name": "room-rent-server",
  "version": "1.0.0",
  "description": "Room Rent Management Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrator.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed.js --demo",
    "seed:clean": "node src/db/seed.js --clean",
